rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    // All money-changing writes go through Cloud Functions/Admin SDK.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isAdmin();
      allow write: if false;
    }
    match /depositRequests/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /withdrawalRequests/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /walletLedger/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /gameRooms/{roomId} {
      allow read: signedIn();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
